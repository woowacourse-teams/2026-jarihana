# Public GitHub OAuth application settings. Never put a GitHub client secret here.
APP_GITHUB_CLIENT_ID=
APP_GITHUB_REDIRECT_URI=http://localhost:8080/api/oauth/github/callback
# Cookie name and optional shared parent domain used to validate OAuth state.
APP_OAUTH_COOKIE_NAME=oauthState
APP_OAUTH_COOKIE_DOMAIN=
# Set this to 1 to turn off React-only diagnostic overlays in development.
DISABLE_REACT_DEVTOOLS=0
