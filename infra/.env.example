# 앱 EC2에서 infra/.env로 복사하고 빈 값을 채운다. dev와 prod는 서로 다른 EC2에서 실행한다.
# SPRING_PROFILES_ACTIVE는 각 앱 Compose의 backend와 alloy에 dev/prod로 고정되어 있다.
# APP_METRICS_TARGET은 두 Compose에 127.0.0.1:8081로 고정되어 있다.
# 같은 주소에서 /actuator/prometheus와 /actuator/health를 수집한다.

# 기존 앱 배포 입력
BACKEND_TAG=
# dev/prod 배포는 RDS_URL, DB_USERNAME, DB_PASSWORD로 RDS에 연결한다.
# dev 예: RDS_URL=<rds-endpoint> → jdbc:postgresql://<rds-endpoint>:5432/jarihana_dev?sslmode=require
# prod 예: RDS_URL=<rds-endpoint> → jdbc:postgresql://<rds-endpoint>:5432/jarihana_prod?sslmode=require
RDS_URL=
DB_USERNAME=
DB_PASSWORD=
# Alloy가 DB를 직접 확인할 때 쓰는 PostgreSQL 접속 DSN. 앱 DB 계정 재사용은 가능하지만,
# 장기 운영에서는 앱 계정이나 관리자 계정과 분리한 모니터링 전용 계정을 권장한다.
# dev 예: postgresql://postgres_monitor:<encoded-password>@<rds-endpoint>:5432/jarihana_dev?sslmode=require&connect_timeout=3
# prod 예: postgresql://postgres_monitor:<encoded-password>@<rds-endpoint>:5432/jarihana_prod?sslmode=require&connect_timeout=3
POSTGRES_MONITOR_DSN=
FRONTEND_ORIGIN=
ACCESS_TOKEN_SECRET=
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=
IMAGE_S3_BUCKET=
IMAGE_S3_REGION=ap-northeast-2
IMAGE_S3_KEY_PREFIX=
IMAGE_S3_PUBLIC_BASE_URL=

# Alloy: HOST_ID는 지표 라벨에 사용할 안정적인 서버 이름이다. 실제 AWS instance ID일 필요는 없다.
HOST_ID=
# 모니터링 EC2의 사설 주소를 사용한다.
# 예: http://<monitoring-private-ip>:9090/api/v1/write
PROMETHEUS_REMOTE_WRITE_URL=
# 예: http://<monitoring-private-ip>:3100/loki/api/v1/push
LOKI_PUSH_URL=
# OTLP gRPC: scheme 없이 모니터링 EC2의 사설 주소:4317
# 예: 10.0.2.10:4317
TEMPO_OTLP_ENDPOINT=
