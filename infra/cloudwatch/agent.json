{
  "agent": {
    "metrics_collection_interval": 60,
    "run_as_user": "root"
  },
  "metrics": {
    "namespace": "Jarihana/prod",
    "append_dimensions": {
      "InstanceId": "${aws:InstanceId}"
    },
    "metrics_collected": {
      "mem": {
        "measurement": ["used_percent"]
      },
      "disk": {
        "measurement": ["used_percent"],
        "resources": ["/"],
        "drop_device": true
      },
      "cpu": {
        "measurement": ["usage_active"],
        "totalcpu": true
      }
    }
  },
  "logs": {
    "force_flush_interval": 5,
    "metrics_collected": {
      "prometheus": {
        "log_group_name": "/jarihana/current/prometheus",
        "prometheus_config_path": "/opt/aws/amazon-cloudwatch-agent/etc/jarihana/prometheus.yaml",
        "emf_processor": {
          "metric_declaration_dedup": true,
          "metric_namespace": "Jarihana/prod",
          "metric_unit": {
            "http_server_requests_seconds_count": "Count",
            "http_server_requests_seconds_sum": "Seconds",
            "jvm_memory_used_bytes": "Bytes",
            "jvm_memory_max_bytes": "Bytes",
            "jvm_threads_live_threads": "Count",
            "jvm_threads_states_threads": "Count",
            "jvm_gc_pause_seconds_count": "Count",
            "jvm_gc_pause_seconds_sum": "Seconds",
            "jvm_gc_overhead": "None",
            "hikaricp_connections_active": "Count",
            "hikaricp_connections_idle": "Count",
            "hikaricp_connections_max": "Count",
            "hikaricp_connections_pending": "Count",
            "hikaricp_connections_timeout_total": "Count",
            "hikaricp_connections_acquire_seconds_count": "Count",
            "hikaricp_connections_acquire_seconds_sum": "Seconds",
            "process_cpu_usage": "None"
          },
          "metric_declaration": [
            {
              "source_labels": ["job", "application", "environment"],
              "label_matcher": "^jarihana-backend;jarihana;current$",
              "dimensions": [["application", "environment", "status_class"]],
              "metric_selectors": ["^http_server_requests_seconds_(count|sum)$"]
            },
            {
              "source_labels": ["job", "application", "environment"],
              "label_matcher": "^jarihana-backend;jarihana;current$",
              "dimensions": [["application", "environment", "area", "id"]],
              "metric_selectors": ["^jvm_memory_(used|max)_bytes$"]
            },
            {
              "source_labels": ["job", "application", "environment"],
              "label_matcher": "^jarihana-backend;jarihana;current$",
              "dimensions": [["application", "environment", "state"]],
              "metric_selectors": ["^jvm_threads_states_threads$"]
            },
            {
              "source_labels": ["job", "application", "environment"],
              "label_matcher": "^jarihana-backend;jarihana;current$",
              "dimensions": [["application", "environment", "pool"]],
              "metric_selectors": [
                "^hikaricp_connections_(active|idle|max|pending)$",
                "^hikaricp_connections_timeout_total$",
                "^hikaricp_connections_acquire_seconds_(count|sum)$"
              ]
            },
            {
              "source_labels": ["job", "application", "environment"],
              "label_matcher": "^jarihana-backend;jarihana;current$",
              "dimensions": [["application", "environment"]],
              "metric_selectors": [
                "^jvm_threads_live_threads$",
                "^jvm_gc_pause_seconds_(count|sum)$",
                "^jvm_gc_overhead$",
                "^process_cpu_usage$"
              ]
            }
          ]
        }
      }
    }
  }
}
