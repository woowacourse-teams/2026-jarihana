worker_processes 1;
error_log /dev/stderr notice;
pid /var/run/nginx.pid;
events { worker_connections 1024; }
http {
    map $http_upgrade $connection_upgrade {
        default upgrade;
        '' close;
    }
    log_format deploy '$time_iso8601 $request_method $uri $status '
                      'upstream=$upstream_addr upstream_status=$upstream_status '
                      'request_time=$request_time upstream_time=$upstream_response_time';
    access_log /dev/stdout deploy;
    upstream application { server @UPSTREAM@; }
    server {
        listen 8080;
        client_max_body_size 10m;
        location ~ ^/api/actuator(?:/|$) { return 404; }
        location /actuator { return 404; }
        location /api/ {
            proxy_pass http://application;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            # Requires HTTPS-only viewer access and restricted CloudFront origin access.
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 3s;
            proxy_read_timeout 300s;
            proxy_send_timeout 300s;
            proxy_next_upstream off;
        }
        location / { return 404; }
    }
    # Publish this port to host loopback only. This is a real upstream API probe.
    server {
        listen 8082;
        location = /__deployment {
            proxy_pass http://application/api/groups?size=1;
            proxy_set_header Host $host;
            proxy_set_header Connection close;
            proxy_next_upstream off;
            proxy_connect_timeout 2s;
            proxy_read_timeout 2s;
            add_header X-Jarihana-Slot @SLOT@ always;
            add_header X-Jarihana-Target @UPSTREAM@ always;
            add_header X-Jarihana-Upstream $upstream_addr always;
        }
        location / { return 404; }
    }
}
