# Copy outside the checkout (for example /opt/jarihana/dev.env), chmod 600,
# and fill every empty value. Never commit real credentials.
BACKEND_TAG=replace-with-dev-commit-sha
POSTGRES_PASSWORD=
ACCESS_TOKEN_SECRET=
OAUTH_GITHUB_CLIENT_SECRET=
FRONTEND_ORIGIN=https://replace-with-dev-domain
OAUTH_GITHUB_CLIENT_ID=
OAUTH_GITHUB_REDIRECT_URI=https://replace-with-dev-domain/api/oauth/github/callback
IMAGE_S3_BUCKET=techcourse-project-2026
IMAGE_S3_REGION=ap-northeast-2
IMAGE_S3_PUBLIC_BASE_URL=https://replace-with-dev-domain/images
# Set after checking production usage and build-time headroom on the shared EC2.
BACKEND_MEMORY_LIMIT=
BACKEND_CPUS=
POSTGRES_MEMORY_LIMIT=
POSTGRES_CPUS=
