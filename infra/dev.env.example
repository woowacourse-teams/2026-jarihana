# Copy outside the checkout (for example /opt/jarihana/dev.env), chmod 600,
# and fill every empty value. Never commit real credentials.
BACKEND_TAG=replace-with-dev-commit-sha
DEV_POSTGRES_PASSWORD=
DEV_ACCESS_TOKEN_SECRET=
DEV_OAUTH_GITHUB_CLIENT_SECRET=
DEV_FRONTEND_ORIGIN=https://replace-with-dev-domain
DEV_OAUTH_GITHUB_CLIENT_ID=
DEV_OAUTH_GITHUB_REDIRECT_URI=https://replace-with-dev-domain/api/oauth/github/callback
DEV_IMAGE_S3_BUCKET=techcourse-project-2026
DEV_IMAGE_S3_REGION=ap-northeast-2
DEV_IMAGE_S3_PUBLIC_BASE_URL=https://replace-with-dev-domain/images
# Set after checking production usage and build-time headroom on the shared EC2.
DEV_BACKEND_MEMORY_LIMIT=
DEV_BACKEND_CPUS=
DEV_POSTGRES_MEMORY_LIMIT=
DEV_POSTGRES_CPUS=
