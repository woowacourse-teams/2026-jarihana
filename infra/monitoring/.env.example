# 로컬/터미널 수동 실행 보조 예시. 자동 배포와 EC2 유지보수에는 .env 파일이 필요 없다.
# 자동 배포에서는 repository Actions variable MONITORING_HOST_ID를 컨테이너 HOST_ID로 매핑한다.
# 이 이름은 backend dev/prod workflow의 vars.HOST_ID와 충돌하지 않게 분리했다.
# 지표 라벨에 사용할 안정적인 모니터링 호스트 이름이며 실제 AWS instance ID일 필요는 없다.
# 앱 EC2의 HOST_ID와 겹치지 않게 설정한다.
HOST_ID=jarihana-monitoring-ec2

# 자동 배포에서는 repository Actions variable MONITORING_BIND_ADDRESS로 주입한다.
# Nginx 80(Grafana)·8080(수집 API) bind용. 실제 EC2에서는 해당 서버의 사설 IPv4로 바꾼다.
# 127.0.0.1 기본값은 같은 서버의 로컬 확인 전용이며 앱 EC2에서는 접근할 수 없다.
MONITORING_BIND_ADDRESS=127.0.0.1

# Grafana 공개 주소는 Compose/Nginx에 http://grafana.jarihana.com/으로 고정한다.
# DNS에서 grafana.jarihana.com을 모니터링 EC2 공인 IP에 연결한다.

# 자동 배포에서는 repository Actions secret SLACK_WEBHOOK_URL로 주입한다.
# Slack 앱의 Incoming Webhook URL. 선택한 채널로 전송하며 실제 값은 커밋하지 않는다.
# Grafana가 시작할 때 알림 provisioning 파일에 반영한다.
SLACK_WEBHOOK_URL=
