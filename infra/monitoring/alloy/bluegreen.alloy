prometheus.scrape "app_green" {
  job_name = "jarihana-backend"
  scrape_interval = "5s"
  scrape_timeout = "4s"
  metrics_path = "/actuator/prometheus"
  targets = [{
    "__address__" = "127.0.0.1:28081",
    "application" = "jarihana",
    "environment" = "prod",
    "instance" = sys.env("HOST_ID") + ":prod:green",
    "color" = "green",
  }]
  forward_to = [prometheus.remote_write.monitoring.receiver]
}

prometheus.exporter.blackbox "chat_readiness" {
  config = encoding.to_json({
    modules = {
      ready = {
        prober = "http",
        timeout = "4s",
        http = {
          valid_status_codes = [200],
          follow_redirects = false,
          fail_if_body_not_matches_regexp = [`"status"\s*:\s*"UP"`],
        },
      },
    },
  })
  target {
    name = "blue"
    address = "http://127.0.0.1:18081/actuator/health/readiness"
    module = "ready"
    labels = { "color" = "blue", "environment" = "prod", "host_id" = sys.env("HOST_ID") }
  }
  target {
    name = "green"
    address = "http://127.0.0.1:28081/actuator/health/readiness"
    module = "ready"
    labels = { "color" = "green", "environment" = "prod", "host_id" = sys.env("HOST_ID") }
  }
}

prometheus.scrape "chat_readiness" {
  job_name = "jarihana-chat-readiness"
  targets = prometheus.exporter.blackbox.chat_readiness.targets
  scrape_interval = "5s"
  scrape_timeout = "4s"
  forward_to = [prometheus.remote_write.monitoring.receiver]
}
