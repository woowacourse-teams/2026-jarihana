      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "(chat_listener_connected{job=\"jarihana-backend\",environment=\"$environment\",instance=~\"${instance:regex}\"}) and on (job, environment, instance) (up{job=\"jarihana-backend\",environment=\"$environment\",instance=~\"${instance:regex}\"} == 1 and (time() - timestamp(up{job=\"jarihana-backend\",environment=\"$environment\",instance=~\"${instance:regex}\"}) < 90))",
