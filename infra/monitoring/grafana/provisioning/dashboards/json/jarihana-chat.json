          "editorMode": "code",
          "expr": "up{job=\"jarihana-backend\",environment=\"$environment\",instance=~\"${instance:regex}\"} and (time() - timestamp(up{job=\"jarihana-backend\",environment=\"$environment\",instance=~\"${instance:regex}\"}) < 90)",
