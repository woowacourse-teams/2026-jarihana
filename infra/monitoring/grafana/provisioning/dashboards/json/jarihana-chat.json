  "panels": [
    {
      "id": 1,
      "title": "앱 지표 수집 · 서버별",
      "description": "최근 90초 내 수집 결과. 0은 수집 실패, 수집 없음은 시계열 부재 또는 오래된 결과입니다. 다른 패널이 비어 있으면 먼저 확인하세요.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 5
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
