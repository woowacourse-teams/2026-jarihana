        "definition": "label_values(up{job=\"jarihana-backend\",environment=\"$environment\"}, instance)",
        "query": {
          "query": "label_values(up{job=\"jarihana-backend\",environment=\"$environment\"}, instance)",
          "refId": "StandardVariableQuery"
