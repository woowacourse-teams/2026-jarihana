    {
      "id": 13,
      "title": "GC 정지 · 초당 누적 정지 시간",
      "description": "누적 GC 정지 시간의 증가율(초/초)입니다. 0.1은 관측 구간에서 초당 약 0.1초 정지를 의미합니다.",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 37,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "interval": "5s",
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
