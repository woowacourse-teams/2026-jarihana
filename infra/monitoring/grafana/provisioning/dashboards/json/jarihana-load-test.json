            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "histogram_quantile(0.95, sum by (le, uri, method) (rate(http_server_requests_seconds_bucket{job=\"jarihana-backend\",environment=\"$environment\",uri!~\"/actuator.*|/error\"}[$__rate_interval])))",
          "legendFormat": "p95 {{method}} {{uri}}",
