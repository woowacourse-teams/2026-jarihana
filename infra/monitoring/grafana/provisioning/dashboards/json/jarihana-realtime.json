  "panels": [
    {
      "id": 1,
      "title": "서비스 헬스",
      "description": "공용 realtime의 HTTP 헬스체크 결과입니다. 개발·운영 DB 점검을 포함합니다.",
      "type": "stat",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "editorMode": "code",
          "expr": "min(probe_success{job=\"jarihana-realtime-health\"} and (time() - timestamp(probe_success{job=\"jarihana-realtime-health\"}) < 90))",
          "instant": true,
          "range": false
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "decimals": 0,
          "noValue": "수집 없음",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
