          "editorMode": "code",
          "expr": "sum(realtime_connections{job=\"jarihana-realtime\"} and on (job, instance) (up{job=\"jarihana-realtime\"} == 1 and (time() - timestamp(up{job=\"jarihana-realtime\"}) < 90)))",
